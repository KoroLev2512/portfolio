# Exposed client-side (not secret). Обязательно продублируй в Vercel → Environment Variables для `next build`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Same ids for CLI / server (not prefixed with NEXT_PUBLIC)
SANITY_PROJECT_ID=
SANITY_DATASET=

# sanity dev/deploy подставляют в бандл студии только SANITY_STUDIO_*.
# Можно продублировать вручную или через dotenv-expand:
# SANITY_STUDIO_PROJECT_ID=${SANITY_PROJECT_ID}
# SANITY_STUDIO_DATASET=${SANITY_DATASET}
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Server-side only (secret)
# Для опубликованного контента на сайте токен НЕ обязателен — оставь пустым.
# Если указан токен от ДРУГОГО проекта → 401 "Session does not match project host" (SIO-401-AWH).
# Создай токен: sanity.io/manage → твой проект (тот же id, что NEXT_PUBLIC_*) → API → Tokens.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
