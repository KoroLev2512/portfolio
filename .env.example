# Канонический URL сайта (без слэша в конце). Обязателен для og:image в проде (иначе в разметке будет localhost).
# Свой домен: NEXT_PUBLIC_SITE_URL=https://dev-by-yurii.ru
# GitHub Pages: https://username.github.io/portfolio
NEXT_PUBLIC_SITE_URL=

# Базовый путь приложения при `next build` (не Vercel). Пусто = сайт в корне домена.
# Свой домен в корне: NEXT_PUBLIC_BASE_PATH=
# GitHub Pages в подпапке: NEXT_PUBLIC_BASE_PATH=/portfolio
# Если не задано — по умолчанию /portfolio (деплой в подпапку, напр. GitHub Pages).
# Сайт в корне своего домена — обязательно NEXT_PUBLIC_BASE_PATH= (пусто).
# NEXT_PUBLIC_BASE_PATH=

# Exposed client-side (not secret). Обязательно передавать при сборке Docker (через .env).
NEXT_PUBLIC_SANITY_PROJECT_ID=3qddo394
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-19
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Same ids for CLI / server (not prefixed with NEXT_PUBLIC)
SANITY_PROJECT_ID=3qddo394
SANITY_DATASET=production

# sanity dev/deploy подставляют в бандл студии только SANITY_STUDIO_*.
# Можно продублировать вручную или через dotenv-expand:
# SANITY_STUDIO_PROJECT_ID=${SANITY_PROJECT_ID}
# SANITY_STUDIO_DATASET=${SANITY_DATASET}
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Server-side only (secret)
# Для опубликованного контента на сайте токен НЕ обязателен — оставь пустым.
# Если указан токен от ДРУГОГО проекта → 401 "Session does not match project host" (SIO-401-AWH).
# Создай токен: sanity.io/manage → твой проект (тот же id, что NEXT_PUBLIC_*) → API → Tokens.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Опционально: интервал revalidate для Data Cache Next при запросе Sanity (секунды). По умолчанию 300.
# SANITY_FETCH_REVALIDATE_SECONDS=300
